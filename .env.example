# BarberLab AI SaaS Environment Variables
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# NVIDIA NIM API KEY (Llama 3.1 / NeVA)
NVIDIA_NIM_API_KEY=nvapi-sample-key-barberlab

# Database Connection URL (Supabase / Postgres / SQLite)
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/barberlab

# Social & Marketing APIs
META_API_KEY=EAAG_sample_meta_barberlab_token
GOOGLE_BUSINESS_API_KEY=AIzaSy_google_business_barberlab_key

# WHATSAPP CLOUD API (META) CONFIGURATION
# WHATSAPP_PHONE_ID: ID do número de telefone exibido no painel da Meta
WHATSAPP_PHONE_ID=109876543210987
# WHATSAPP_BUSINESS_ACCOUNT_ID: ID da conta do WhatsApp Business na Meta
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
# WHATSAPP_ACCESS_TOKEN: Token de acesso do painel Meta (Graph API v18.0)
WHATSAPP_ACCESS_TOKEN=EAAG_sample_whatsapp_cloud_api_token
# DOMÍNIO E BASE URL DA APLICAÇÃO
APP_DOMAIN_URL=https://barbeariadojoao.com.br

